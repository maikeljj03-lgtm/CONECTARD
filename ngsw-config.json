{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": ["/favicon.ico", "/index.html", "/manifest.webmanifest", "/*.css", "/*.js"]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": ["/assets/**", "/svg/**", "/media/**", "/*.(svg|cur|jpg|jpeg|png|apng|webp|avif|gif|otf|ttf|woff|woff2)"]
      }
    },
    {
      "name": "fonts",
      "installMode": "lazy",
      "updateMode": "lazy",
      "resources": {
        "urls": ["https://fonts.googleapis.com/**", "https://fonts.gstatic.com/**"]
      }
    }
  ],
  "dataGroups": [
    {
      "name": "mapa",
      "urls": ["https://tile.openstreetmap.org/**"],
      "cacheConfig": { "strategy": "performance", "maxSize": 600, "maxAge": "7d" }
    },
    {
      "name": "fotos",
      "urls": ["https://*.supabase.co/storage/v1/object/public/**"],
      "cacheConfig": { "strategy": "performance", "maxSize": 300, "maxAge": "30d" }
    },
    {
      "name": "datos-publicos",
      "urls": [
        "https://*.supabase.co/rest/v1/public_reports*",
        "https://*.supabase.co/rest/v1/public_events*",
        "https://*.supabase.co/rest/v1/rpc/leaderboard*"
      ],
      "cacheConfig": { "strategy": "freshness", "maxSize": 80, "maxAge": "3d", "timeout": "6s" }
    }
  ],
  "navigationUrls": ["/**", "!/**/*.*", "!/**/*__*", "!/**/*__*/**"]
}
